{
  "name": "pixmind",
  "version": "1.0.0",
  "description": "本地 AI 图片管理与搜索桌面应用 (Electron + Vue3 + CLIP)",
  "main": "dist-electron/main.js",
  "author": "PixMind",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "download-models": "node scripts/download-models.mjs",
    "prebuild": "vue-tsc --noEmit && vite build",
    "build": "npm run prebuild && electron-builder",
    "build:mac": "npm run prebuild && electron-builder --mac --x64 --arm64",
    "build:win": "npm run prebuild && electron-builder --win --x64",
    "build:linux": "npm run prebuild && electron-builder --linux",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "element-plus": "^2.8.4",
    "onnxruntime-node": "^1.19.2",
    "pinia": "^2.2.4",
    "sharp": "^0.33.5",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "com.pixmind.app",
    "productName": "PixMind",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  }
}
